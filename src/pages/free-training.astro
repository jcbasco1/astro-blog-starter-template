---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Featured Free Training | ExpositionHub"
  description="A featured free training resource covering an online business model and passive income concepts."
>
  <main class="container">
    <article class="card">
      <p class="eyebrow">Featured Free Training</p>
      <h1>Beginner-Friendly Online Business Training</h1>
      <p class="intro">
        This featured training is aimed at people researching beginner-friendly online
        business models and leveraged service delivery.
      </p>

      <p>
        It is structured as a free registration funnel rather than a direct checkout
        page, which makes it better suited to readers who want more explanation
        before deciding whether the offer fits.
      </p>

      <ul>
        <li>free entry point</li>
        <li>beginner-oriented framing</li>
        <li>focused on online business and leveraged fulfillment</li>
        <li>best used after reading a guide or review first</li>
      </ul>

      <p class="cta-wrap">
        <a class="cta-button" href="/go/passive-income-system">Watch the Free Training</a>
      </p>
    </article>
  </main>
</SiteLayout>

<style>
  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 18px;
    padding: 2rem;
    color: #e2e8f0;
    box-shadow: 0 20px 40px rgba(0,0,0,0.35);
  }

  .eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.5rem;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #f8fafc;
  }

  .intro, p, li {
    color: #cbd5e1;
  }

  .cta-wrap {
    margin-top: 1.5rem;
  }

  .cta-button {
    display: inline-block;
    padding: 0.95rem 1.25rem;
    border-radius: 12px;
    background: #22c55e;
    color: #052e16;
    text-decoration: none;
    font-weight: 700;
  }

  .cta-button:hover {
    background: #16a34a;
  }
</style>

---
const targetUrl = "https://www.digistore24.com/redir/361682/expositionhub/";
const escapedTargetUrl = JSON.stringify(targetUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <meta name="robots" content="noindex, nofollow" />
    <title>Redirecting...</title>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        background: #020617;
        color: #e2e8f0;
        padding: 40px;
        line-height: 1.6;
      }

      a {
        color: #38bdf8;
      }
    </style>
  </head>
  <body>
    <p>Redirecting to the featured training...</p>
    <p>If you are not redirected, <a href={targetUrl}>click here</a>.</p>

    <script is:inline>
      window.location.replace({escapedTargetUrl});
    </script>
  </body>
</html>